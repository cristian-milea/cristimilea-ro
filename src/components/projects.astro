---
import { Image } from "astro:assets";
import kontrolF from "../assets/projects/kontrol-f.png";
import couplestars from "../assets/projects/couplestars.png";
import capitalSwipe from "../assets/projects/capital-swipe.png";
import inkCartridge from "../assets/projects/ink-cartridge.png";
import travelUnicorns from "../assets/projects/travelunicorns.jpg";

type Badge = "website" | "github" | "apple" | "google";

interface Project {
  title: string;
  image: ImageMetadata;
  status: string;
  description: string;
  tags: string[];
  links: { badge: Badge; href: string; label?: [string, string] }[];
}

const projects: Project[] = [
  {
    title: "Kontrol-F",
    image: kontrolF as ImageMetadata,
    status: "Live",
    description:
      "AI-driven CFO platform for multi-tenant financial management: document ingestion, BigQuery analytics, conversational AI, and a custom formula DSL.",
    tags: [
      "Next.js",
      "NestJS",
      "PostgreSQL",
      "MongoDB",
      "DuckDB",
      "BigQuery",
      "Vertex AI",
      "Stripe",
      "Clerk",
    ],
    links: [{ badge: "website", href: "https://kontrol-f.ai" }],
  },
  {
    title: "CoupleStars",
    image: couplestars as ImageMetadata,
    status: "Live",
    description:
      "A shared space for couples to stay organized and connected, from one codebase across iOS, Android, and Web.",
    tags: ["Expo", "Tamagui", "Supabase"],
    links: [
      { badge: "website", href: "https://couplestars.com" },
      { badge: "apple", href: "https://apps.apple.com/app/id6762174159" },
      {
        badge: "google",
        href: "https://play.google.com/store/apps/details?id=com.couplestars.app",
      },
    ],
  },
  {
    title: "Capital Swipe",
    image: capitalSwipe as ImageMetadata,
    status: "iOS Live",
    description:
      "A flag-to-capital swipe quiz game, offline-first, no backend. Live on iOS; Android still in review.",
    tags: ["Expo", "React Native", "TypeScript"],
    links: [
      {
        badge: "apple",
        href: "https://apps.apple.com/us/app/capital-swipe/id1530711664",
      },
    ],
  },
  {
    title: "Ink Cartridge",
    image: inkCartridge as ImageMetadata,
    status: "Live",
    description:
      "Open-source app store for pwnagotchi e-ink devices: a Python plugin/catalog system plus native companion apps for Android and iOS over Bluetooth.",
    tags: ["Kotlin", "Swift", "Python", "Bluetooth"],
    links: [
      {
        badge: "github",
        href: "https://github.com/cristian-milea/ink-cartridges",
      },
      {
        badge: "apple",
        href: "https://apps.apple.com/us/app/ink-cartridge/id6774989679",
      },
      {
        badge: "google",
        href: "https://play.google.com/store/apps/details?id=io.github.cristianmilea.inkcartridgeapp",
      },
      {
        badge: "website",
        href: "https://ink-cartridge-studio.cristimilea.ro",
        label: ["For Developers", "Ink Cartridge Studio"],
      },
    ],
  },
  {
    title: "TravelUnicorns",
    image: travelUnicorns as ImageMetadata,
    status: "Live",
    description: "Travel blog and brand site.",
    tags: [],
    links: [{ badge: "website", href: "https://travelunicorns.com" }],
  },
];
---

<section
  id="projects"
  class="py-12 border-t border-[#ffffff10] text-[var(--white)]"
>
  <div class="max-w-5xl mx-auto">
    <h2 class="text-lg text-[var(--sec)] mb-2 shiny-sec">My work</h2>
    <h3 class="text-4xl md:text-5xl font-medium mb-8">Projects</h3>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
      {
        projects.map((project) => (
          <div class="group">
            <div class="rounded-2xl overflow-hidden shadow-lg hover:shadow-xl transition-shadow duration-300 mb-4">
              <Image
                src={project.image}
                alt={project.title}
                class="w-full h-48 md:h-72 object-cover group-hover:scale-105 transition-transform duration-300"
              />
            </div>
            <div class="px-3">
              <div class="flex items-center justify-between mb-1">
                <h4 class="text-2xl font-semibold">{project.title}</h4>
                <span
                  class={`text-xs px-2 py-1 rounded-full border ${
                    project.status === "Live"
                      ? "border-[var(--sec)] text-[var(--sec)]"
                      : "border-[var(--white-icon-tr)] text-[var(--white-icon)]"
                  }`}
                >
                  {project.status}
                </span>
              </div>
              <p class="text-sm text-[var(--white-icon)] mb-3">
                {project.description}
              </p>
              {project.tags.length > 0 && (
                <div class="flex flex-wrap gap-2 mb-4">
                  {project.tags.map((tag) => (
                    <span class="text-xs px-2 py-1 rounded-md bg-[#1414149c] text-[var(--white-icon)] border border-[var(--white-icon-tr)]">
                      {tag}
                    </span>
                  ))}
                </div>
              )}
              <div class="flex flex-wrap items-center gap-2">
                {project.links.map((link) => (
                  <a
                    target="_blank"
                    rel="noopener noreferrer"
                    href={link.href}
                    class="hover:opacity-80 transition-opacity duration-300 ease-in-out"
                  >
                    {link.badge === "apple" && (
                      <img
                        src="/badges/app-store.svg"
                        alt="Download on the App Store"
                        class="h-10"
                      />
                    )}
                    {link.badge === "google" && (
                      <img
                        src="/badges/google-play.png"
                        alt="Get it on Google Play"
                        class="h-10"
                      />
                    )}
                    {link.badge === "website" && (
                      <span class="h-10 px-3 rounded-lg border border-[var(--sec)] bg-black flex items-center gap-2">
                        <svg
                          xmlns="http://www.w3.org/2000/svg"
                          viewBox="0 0 24 24"
                          fill="none"
                          stroke="currentColor"
                          stroke-width="2"
                          stroke-linecap="round"
                          stroke-linejoin="round"
                          class="w-6 h-6 shrink-0 text-[var(--sec)]"
                        >
                          <circle cx="12" cy="12" r="10" />
                          <line x1="2" y1="12" x2="22" y2="12" />
                          <path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z" />
                        </svg>
                        <span class="flex flex-col justify-center leading-tight">
                          <span class="text-[9px] uppercase tracking-wide text-[var(--white-icon)]">
                            {link.label ? link.label[0] : "Visit at"}
                          </span>
                          <span class="text-sm font-semibold text-white">
                            {link.label
                              ? link.label[1]
                              : new URL(link.href).hostname}
                          </span>
                        </span>
                      </span>
                    )}
                    {link.badge === "github" && (
                      <span class="h-10 px-3 rounded-lg border border-white bg-black flex items-center gap-1.5 text-sm font-medium text-white">
                        <svg
                          xmlns="http://www.w3.org/2000/svg"
                          viewBox="0 0 24 24"
                          fill="currentColor"
                          class="w-6 h-6 shrink-0"
                        >
                          <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z" />
                        </svg>
                        GitHub
                      </span>
                    )}
                  </a>
                ))}
              </div>
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>
